# Salin menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.
# Nilai: Supabase Dashboard > Project Settings > API Keys.
# Bila kosong, dasbor berjalan dalam mode demo memakai src/data/dummy-sensor.json.
#
# Kedua variabel ini PUBLIK (ikut terkirim ke browser). Pakai key "publishable"
# (sb_publishable_...). JANGAN isi dengan secret key / service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Alternatif untuk project lama: anon key JWT. Dipakai hanya bila PUBLISHABLE_KEY kosong.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
